{
  "manifestVersion": 5,
  "id": "com.frameflow.premiere.host",
  "name": "FrameFlow Premiere Host",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "hostUIContext": {
    "hideFromMenu": true
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "command",
      "id": "frameflowHostService",
      "label": { "default": "FrameFlow Host Service" }
    }
  ]
}
