{
  "manifestVersion": 5,
  "id": "com.frameflow.premiere.spike",
  "name": "FrameFlow Spike",
  "version": "0.0.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/ff23.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": ["https"],
      "extensions": []
    },
    "network": {
      "domains": [
        "https://api.getframeflow.app",
        "https://cdn.getframeflow.app",
        "https://fonts.gstatic.com"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "ffSpikePanel",
      "label": { "default": "FrameFlow Spike" },
      "minimumSize": { "width": 320, "height": 300 },
      "preferredDockedSize": { "width": 420, "height": 700 },
      "preferredFloatingSize": { "width": 560, "height": 800 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/ff23.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "lightest", "light", "all"]
        }
      ]
    }
  ]
}
