<?xml version="1.0" encoding="UTF-8"?>
<!-- CUSTOMER (public) manifest — FAQAT com.frameflow.panel.
     Ichki Admin paneli ALOHIDA manifestda: CSXS/manifest.admin.xml (mijozga chiqmaydi).
     Flavor manbai: scripts/package-flavors.mjs · hujjat: docs/RELEASE-ARCHITECTURE.md
     ExtensionBundleVersion AssetFlow_Plugin.html'dagi window.AF_PLUGIN_VERSION bilan SINXRON. -->
<ExtensionManifest Version="7.0"
  ExtensionBundleId="com.frameflow"
  ExtensionBundleVersion="1.2.0"
  ExtensionBundleName="FrameFlow">
  <ExtensionList>
    <Extension Id="com.frameflow.panel" Version="1.2.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[22.0,99.9]"/>
      <Host Name="PPRO" Version="[22.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.frameflow.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./AssetFlow_Plugin.html</MainPath>
          <ScriptPath>./jsx/host-bootstrap.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- Node/local-file mijoz oqimi uchun KERAK (import, pack yuklab olish/ochish).
                 Web-security'ni o'chiruvchi CEF bayrog'i TAQIQLANGAN (test shuni tekshiradi) —
                 API birinchi-tomon HTTPS + CORS orqali chaqiriladi. -->
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--persist-session-cookies</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>FrameFlow</Menu>
          <Geometry>
            <Size><Height>720</Height><Width>380</Width></Size>
            <MinSize><Height>400</Height><Width>320</Width></MinSize>
          </Geometry>
          <!-- #148 (PX11): ikonalarsiz panel AE "Window → Extensions" ro'yxatida bo'sh
               to'rtburchak bilan chiqardi. Fayllar GENERATSIYA: scripts/make-panel-icons.mjs
               (brend chaqmog'i, 23×23). Yorug'/qorong'i AE mavzusi uchun alohida rang. -->
          <Icons>
            <Icon Type="Normal">./icons/panel-normal.png</Icon>
            <Icon Type="RollOver">./icons/panel-rollover.png</Icon>
            <Icon Type="Disabled">./icons/panel-disabled.png</Icon>
            <Icon Type="DarkNormal">./icons/panel-dark-normal.png</Icon>
            <Icon Type="DarkRollOver">./icons/panel-dark-rollover.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
